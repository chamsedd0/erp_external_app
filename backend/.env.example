PORT=3000

JWT_SECRET=replace-with-a-long-random-secret
ADMIN_SECRET=replace-with-a-long-random-admin-secret

UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=no-reply@your-domain.com

CRON_SECRET=replace-with-a-long-random-cron-secret
PORTAL_AUTH_SECRET=replace-with-a-long-random-portal-secret
ACTIVATION_OTP_TTL_SECONDS=600
ACTIVATION_INVITE_TTL_SECONDS=86400
