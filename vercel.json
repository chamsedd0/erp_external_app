{
    "version": 2,
    "builds": [
        {
            "src": "backend/src/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "backend/src/index.ts"
        }
    ],
    "crons": [
        {
            "path": "/cron/check-updates",
            "schedule": "*/15 * * * *"
        }
    ],
    "env": {
        "PORT": "3000"
    }
}
